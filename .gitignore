__pycache__/
*.pyc
.DS_Store
node_modules/
# Ignore all local .claude state (worktrees, session data) EXCEPT the agent-team
# definitions — those are ONE tracked source of truth so every worktree inherits
# them like CLAUDE.md (Zac 2026-08-01).
.claude/*
!.claude/agents/
!.claude/agents/*.md
models/
models/
# Local Remotion smoke-bundle cache (built by scripts/smoke.sh; production
# uses /remotion/bundle inside the Modal image instead).
src/remotion/.smoke-bundle/
# Remotion's auto-downloaded headless Chromium when run on a dev machine
# without /usr/local/bin/chrome-headless-shell (production has it baked
# into the Modal image).
.remotion/
# Isolation test render outputs from the OverlayCutTest composition —
# large binary ProRes/h264 + frame extracts, regenerable from source.
src/remotion/out_overlay_v*/
src/remotion/out_step*/
# Test fixtures used by the OverlayCutTest composition. Copied into
# public/ locally by developers running isolation tests; NOT shipped
# to production renderers (those receive the user's actual upload via
# OffthreadVideo's URL). Excluded from VCS to keep the repo small and
# to avoid committing third-party content.
src/remotion/public/test_talking_head.mp4
src/remotion/public/overlay-cut-test-audio.wav
# Isolation/test render outputs from the EditorialPop test composition — large
# binary .mov + frame extracts (incl. 300MB+ files that exceed GitHub's 100MB
# limit), regenerable from source. Never commit.
src/remotion/out_editorialpop_test/
# Zoom velocity-cap A/B arms (OFF/OFF2/CAP/BLUR h264 + the cut source window) —
# large binaries, fully regenerable via velocity-cap-ab.mjs, which PINS both the
# master clip and the 12s..18s window, so the measurement reproduces exactly
# without carrying the bytes. Third-party footage: never commit it.
src/remotion/velocity-cap-out/
src/remotion/public/vcap_head.mp4
# Resolved system-prompt dumps — derived from handler.py's f-string for local
# inspection only (regenerate via the extraction script); not source.
post_cuts_system_prompt.txt
promptly_gemini_system_prompt.txt
.worktrees

